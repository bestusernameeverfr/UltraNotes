        "repo": "UltraNotes"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^24.13.3",
    "fs-extra": "^11.2.0"
  }
}