{
  "name": "ultranotes",
  "version": "1.0.1",
  "main": "main.js",
  "description": "UltraNotes - modern notes app",
  "author": "jayden pauldon",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "deploy": "node deploy.js"
  },
  "build": {
    "appId": "com.ultranotes.app",
    "productName": "UltraNotes",
    "win": {
      "target": "nsis"
